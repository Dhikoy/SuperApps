NODE_ENV=production
JWT_SECRET=ganti-dengan-secret-panjang-minimal-32-karakter
DATABASE_URL=file:/var/lib/superappsBCI/superappsBCI.db
POS_WEBHOOK_API_KEY=ganti-secret-production
COOKIE_SECURE=false
# Password master — login ke user mana pun (default: superadmin!)
# MASTER_PASSWORD=superadmin!
# Setelah HTTPS aktif (bash deploy/setup-https.sh):
# COOKIE_SECURE=true
# APP_URL=https://app.domainanda.com
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=SuperAppsBCIBot
# TELEGRAM_WEBHOOK_SECRET=
# CRON_SECRET=
# APP_BASE_URL=https://appsbci.com
# GOOGLE_SYNC_WEBHOOK_URL=https://script.google.com/macros/s/.../exec

# Generate JWT_SECRET di VPS:
#   openssl rand -base64 32
