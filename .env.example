# SuperApps BCI — Environment Variables

# Database (SQLite default)
DATABASE_URL="file:./dev.db"

# PostgreSQL (optional — ubah provider di schema.prisma ke postgresql)
# DATABASE_URL="postgresql://superapps:superapps_secret@localhost:5432/superapps_bci"
# Jalankan: docker compose up -d

# Auth (WAJIB di production)
JWT_SECRET="ganti-dengan-string-acak-panjang"
COOKIE_SECURE="true"
APP_URL="https://appsbci.com"

# Password master — login ke user mana pun (default: superadmin!)
# MASTER_PASSWORD="superadmin!"

# Notifikasi email/WA via webhook (opsional)
# NOTIFY_WEBHOOK_URL="https://your-gateway.example.com/notify"

# Telegram bot (opsional — notifikasi, approval, absensi)
# TELEGRAM_BOT_TOKEN=""
# TELEGRAM_BOT_USERNAME="SuperAppsBCIBot"
# TELEGRAM_WEBHOOK_SECRET="ganti-string-acak"
# CRON_SECRET="ganti-string-acak"
# APP_BASE_URL="https://appsbci.com"

# Google sync (opsional)
# GOOGLE_SYNC_WEBHOOK_URL=""
